                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "depends_on": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "responsible_function": {
                  "type": "string",
                  "minLength": 1
                },
