          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "entry_rule": {
            "type": "string",
            "minLength": 1
          },
          "responsible_function": {
            "type": "string",
            "minLength": 1
          },
          "accountable_human": {
            "type": "string",
            "minLength": 1
          },
          "permitted_automation": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
